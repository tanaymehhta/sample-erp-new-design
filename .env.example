# =================================
# POLYMER TRADING SYSTEM - ENVIRONMENT CONFIGURATION
# =================================
# SECURITY WARNING: Never commit actual values to version control
# Copy this file to .env and fill in your actual values
# =================================

# =================================
# GOOGLE SHEETS INTEGRATION
# =================================
# Path to your Google service account JSON file
GOOGLE_CREDENTIALS_PATH=/path/to/your/google-service-account.json
# Google Sheets document ID (from the URL)
GOOGLE_SHEETS_ID=your_google_sheets_id_here

# =================================
# WHATSAPP BUSINESS API
# =================================
# WhatsApp Business API access token
WHATSAPP_API_TOKEN=your_whatsapp_token_here
# WhatsApp API base URL
WHATSAPP_API_URL=https://graph.facebook.com/v17.0
# Your WhatsApp phone number ID
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# =================================
# TELEGRAM BOT INTEGRATION
# =================================
# Telegram bot token from @BotFather
TELEGRAM_API_TOKEN=your_telegram_bot_token
# Telegram chat IDs for notifications
TELEGRAM_CHAT_ID_LOGISTICS=your_logistics_chat_id
TELEGRAM_CHAT_ID_ACCOUNTS=your_accounts_chat_id
TELEGRAM_CHAT_ID_BOSS1=your_boss1_chat_id
TELEGRAM_CHAT_ID_BOSSOG=your_boss2_chat_id

# =================================
# WHATSAPP PHONE NUMBERS
# =================================
WHATSAPP_PHONE_ACCOUNTS=phone_number_for_accounts
WHATSAPP_PHONE_LOGISTICS=phone_number_for_logistics
WHATSAPP_PHONE_BOSS1=phone_number_for_boss1
WHATSAPP_PHONE_BOSSOG=phone_number_for_boss2

# =================================
# AI/ML SERVICES
# =================================
# OpenAI API key for AI features
OPENAI_API_KEY=your_openai_api_key_here

# =================================
# AUTHENTICATION & SECURITY
# =================================
# JWT secret for authentication (minimum 32 characters)
JWT_SECRET=your_very_secure_jwt_secret_at_least_32_characters_long
# Session timeout in minutes
SESSION_TIMEOUT=1440

# =================================
# DATABASE CONFIGURATION
# =================================
# Database connection URL
# Development: file:./dev.db
# Production: postgresql://user:password@host:port/database
DATABASE_URL=file:./dev.db

# =================================
# SERVER CONFIGURATION
# =================================
# Port for the server to run on
PORT=3001
# Node environment (development, production, test)
NODE_ENV=development
# Enable debug logging
DEBUG=false

# =================================
# RATE LIMITING & SECURITY
# =================================
# Enable rate limiting in production
ENABLE_RATE_LIMITING=true
# Maximum requests per minute per IP
RATE_LIMIT_MAX=100
# Enable CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =================================
# OPTIONAL FEATURES
# =================================
# Enable advanced analytics
ENABLE_ANALYTICS=true
# Enable WhatsApp notifications
ENABLE_WHATSAPP_NOTIFICATIONS=true
# Enable Telegram notifications
ENABLE_TELEGRAM_NOTIFICATIONS=true
# Enable audit logging
ENABLE_AUDIT_LOG=true
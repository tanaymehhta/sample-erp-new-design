SOLUTION_TYPES_1_TITLE="Replace Any Types with Proper Definitions"
SOLUTION_TYPES_1_API_SERVICE="// src/shared/services/apiService.ts\n// Replace: private handleError(error: any): ApiError\nprivate handleError(error: AxiosError | Error): ApiError {\n  if (axios.isAxiosError(error)) {\n    return {\n      message: error.response?.data?.message || error.message,\n      status: error.response?.status || 500,\n      code: error.response?.data?.code || 'UNKNOWN_ERROR'\n    }\n  }\n  return {\n    message: error.message,\n    status: 500,\n    code: 'INTERNAL_ERROR'\n  }\n}"
SOLUTION_TYPES_1_EVENT_TYPES="// src/shared/types/events.ts\nexport interface EventPayload {\n  [EVENT_TYPES.DEAL_CREATED]: { dealId: number; deal: Deal }\n  [EVENT_TYPES.DEAL_UPDATED]: { dealId: number; changes: Partial<Deal> }\n  [EVENT_TYPES.INVENTORY_UPDATED]: { productId: number; quantity: number }\n}\n\n// Usage\neventBus.emit(EVENT_TYPES.DEAL_CREATED, { dealId: 1, deal: newDeal })"
